# ============================================================
#  Smart Loan EMI Analytics Dashboard — Environment Variables
# ============================================================
#  HOW TO USE:
#  1. Copy this file:   cp .env.example .env
#  2. Fill in your own values below
#  3. NEVER commit the actual .env file to GitHub
# ============================================================

# Flask Session Encryption Key
# Generate a strong random key using: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change_this_to_a_long_random_secret_key

# MongoDB Connection URI
# Local:   mongodb://localhost:27017/
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGO_URI=mongodb://localhost:27017/

# FRED API Key — for fetching India benchmark interest rates
# Get your free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
